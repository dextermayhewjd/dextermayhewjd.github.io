+    def _initialize_plain_log_mount(self, targets: list[str]) -> None:
+        if self._harbor_mounts.keys() != {_LOGS}:
+            return
+        source, read_only = self._harbor_mounts[_LOGS]
+        if read_only:
+            return
+
+        # Under this single-bind condition /logs is the only explicit target.
+        # All remaining targets in Harbor's merged list are declared outputs.
+        outputs = [_environment_path(value) for value in targets if value != str(_LOGS)]
+        if not outputs or any(output.parent != _LOGS for output in outputs):
+            return
+        if not os.access(source, os.W_OK | os.X_OK):
+            return
+        fd = os.open(source, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW)
+        try:
+            # Only bootstrap fresh outputs. Creating a sibling of a populated tree
+            # could activate a dangling log link that copytree preserves as a link.
+            missing = []
+            for output in outputs:
+                try:
+                    child = os.open(
+                        output.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd
+                    )
+                except FileNotFoundError:
+                    missing.append(output)
+                    continue
+                except OSError:
+                    return  # Occupied or uninspectable output: keep the original layout.
+                try:
+                    with os.scandir(child) as entries:
+                        if next(entries, None) is not None:
+                            return
+                except OSError:
+                    return
+                finally:
+                    os.close(child)
+            artifacts = EnvironmentPaths.for_os(self.os).artifacts_dir
+            for output in missing:
+                try:
+                    os.mkdir(output.name, dir_fd=fd)
+                except FileExistsError:
+                    continue
+                except OSError:
+                    if output == artifacts:
+                        continue  # Publishing artifacts is optional.
+                    raise
+                if not os.access(output.name, os.R_OK | os.W_OK | os.X_OK, dir_fd=fd):
+                    os.rmdir(output.name, dir_fd=fd)
+                    raise PermissionError(f"cannot write and collect new Harbor output: {output}")
+        finally:
+            os.close(fd)
+
     async def stop(self, delete: bool) -> None:
         del delete
         processes = tuple(self._processes)
