+_PREPARE_MOUNTED_OUTPUTS = r"""
+import errno
+import json
+import os
+from pathlib import Path
+import stat
+import sys
+
+publish_dir = sys.argv[2]
+directory = os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW
+
+pending = json.loads(sys.argv[1])
+log_checks = json.loads(sys.argv[4])
+mountpoints = []
+if sys.argv[3] or log_checks:
+    # mountinfo field 5 is the kernel's mountpoint, including covered binds.
+    for line in Path("/proc/self/mountinfo").read_bytes().splitlines():
+        field = line.split(b" ", 5)[4]
+        for escaped, plain in ((br"\040", b" "), (br"\011", b"\t"), (br"\012", b"\n"), (br"\134", b"\\")):
+            field = field.replace(escaped, plain)
+        mountpoints.append(Path(os.fsdecode(field)))
+
+if sys.argv[3]:
+    gateway = Path(sys.argv[3])
+    runtime_parents = list(map(Path, sys.argv[5:]))
+    for point in mountpoints:
+        if point in runtime_parents:
+            runtime_parents.remove(point)
+            continue
+        if point == Path("/"):
+            continue
+        if point == gateway or gateway in point.parents or point in gateway.parents:
+            print(json.dumps(["gateway", str(point)]))
+            sys.exit(1)
+
+
+def verify_collection(fd, expected):
+    try:
+        matches = os.path.samestat(os.fstat(fd), expected.stat())
+    except FileNotFoundError:
+        matches = False
+    if not matches:
+        raise ValueError("output differs from collection path")
+
+
+def prepare(name, mount, collection):
+    path = Path(name)
+    if name == publish_dir:
+        # Harbor collects artifacts best-effort. Preserve any entry the user supplied.
+        try:
+            path.lstat()
+        except FileNotFoundError:
+            pass
+        except PermissionError:
+            return
+        else:
+            return
+    root = Path(mount).resolve(strict=True)
+    path.resolve().relative_to(root)
+    if collection is None:
+        raise ValueError(name)
+    expected = Path(collection)
+
+    # Walk back both views to the sandbox parent that actually exists.
+    missing = []
+    while True:
+        try:
+            if stat.S_ISDIR(path.stat().st_mode):
+                break
+        except FileNotFoundError:
+            pass
+        if os.path.lexists(path):
+            raise FileExistsError(errno.EEXIST, name)
+        if path.name != expected.name:
+            raise ValueError(name)
+        missing.append(path.name)
+        path, expected = path.parent, expected.parent
+
+    fd = os.open(root, directory)
+    try:
+        for part in path.resolve(strict=True).relative_to(root).parts:
+            child = os.open(part, directory, dir_fd=fd)
+            os.close(fd)
+            fd = child
+        for part in reversed(missing):
+            # Check the immediate parent through the unoverlaid collection view.
+            verify_collection(fd, expected)
+            try:
+                os.mkdir(part, dir_fd=fd)
+            except FileExistsError:
+                if name == publish_dir:
+                    return
+                # A concurrent writer may have supplied this required directory.
+            except OSError as error:
+                if name == publish_dir:
+                    return
+                raise
+            child = os.open(part, directory, dir_fd=fd)
+            os.close(fd)
+            fd = child
+            expected = expected / part
+        verify_collection(fd, expected)  # Includes outputs supplied by an earlier item.
+    finally:
+        os.close(fd)
+
+
+while pending:
+    retry = []
+    for item in pending:
+        try:
+            prepare(*item)
+        except ValueError:
+            print(json.dumps([None, item[0]]))
+            sys.exit(1)
+        except OSError as error:
+            retry.append(item)
+            if len(retry) == 1:
+                first_error = [error.errno, item[0]]
+    # A writable alias may have supplied a directory that failed earlier.
+    if len(retry) == len(pending):
+        print(json.dumps(first_error))
+        sys.exit(1)
+    pending = retry
+
+# Harbor downloads each log root as one directory from the host.
+for name, (collection, mounted) in log_checks.items():
+    if mounted and not os.access(name, os.W_OK | os.X_OK, effective_ids=True):
+        print(json.dumps([errno.EACCES, name]))
+        sys.exit(1)
+    root = Path(name).resolve(strict=True)
