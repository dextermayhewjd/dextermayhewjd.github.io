+@pytest.mark.parametrize("code", [errno.EPERM, errno.ENOSPC, errno.EDQUOT])
+def test_optional_mkdir_failure_preserves_required_errors(monkeypatch, tmp_path, capsys, role, code):
+    target = str(tmp_path / role)
+    plans = [[target, str(tmp_path), target]]
+    monkeypatch.setattr(sys, "argv", ["prepare", json.dumps(plans), str(tmp_path / "artifacts"), "", "{}"])
+    mkdir = os.mkdir
+
+    def deny_creation(path, *args, **kwargs):
+        if path == role and kwargs.get("dir_fd") is not None:
+            raise OSError(code, os.strerror(code), path)
+        return mkdir(path, *args, **kwargs)
+
+    monkeypatch.setattr(os, "mkdir", deny_creation)
+    if role == "artifacts":
+        exec(environment_module._PREPARE_MOUNTED_OUTPUTS, {})
+    else:
+        with pytest.raises(SystemExit) as error:
+            exec(environment_module._PREPARE_MOUNTED_OUTPUTS, {})
+        assert error.value.code == 1
+        assert json.loads(capsys.readouterr().out) == [code, target]
+    assert not os.path.lexists(target)
