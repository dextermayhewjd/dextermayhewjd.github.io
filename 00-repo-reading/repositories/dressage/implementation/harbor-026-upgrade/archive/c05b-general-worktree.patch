+            entry = Path(collection) / point.relative_to(root)
+            try:
+                visible = entry.resolve() == entry and entry.samefile(point)
+            except (OSError, RuntimeError):
+                visible = False
+            if not visible:
+                print(json.dumps(["submount", str(point)]))
+                sys.exit(1)
