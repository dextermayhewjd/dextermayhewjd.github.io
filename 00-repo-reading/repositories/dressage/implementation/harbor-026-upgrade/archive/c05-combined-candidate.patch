+        (logs / "agent/view/data").write_bytes(b"hidden")
+    view.mkdir()
+    (view / "data").write_bytes(b"visible")
+    mounts = [
+        {"type": "bind", "source": str(logs), "target": "/logs"},
+        {"type": "bind", "source": str(view), "target": "/logs/agent/view"},
+    ]
