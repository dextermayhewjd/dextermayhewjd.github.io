+"""File operations shared by the Harbor backend and its mount-namespace helper."""
+
+import errno
+import json
+import os
+from pathlib import Path
+import shutil
+import sys
+
+
+ERROR_EXIT = 65
+
+
+def require_source(source: Path, *, directory: bool) -> None:
+    if directory and not source.is_dir():
+        raise NotADirectoryError(errno.ENOTDIR, os.strerror(errno.ENOTDIR), str(source))
+    if not directory and not source.is_file():
+        raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), str(source))
+
+
+def copy_path(source: Path, target: Path, *, directory: bool) -> None:
+    require_source(source, directory=directory)
+    if directory:
+        target.mkdir(parents=True, exist_ok=True)
+        shutil.copytree(source, target, dirs_exist_ok=True, symlinks=True)
+    else:
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(source, target)
+
+
+def check_mount(path: Path, root: Path) -> None:
+    # Resolve only for the boundary check. The syscall below must walk the original
+    # path, including components that precede ".." inside a symlink.
+    if not path.resolve().is_relative_to(root.resolve()):
+        raise ValueError(f"environment path escapes its mount: {path}")
+
+
+def prepare_outputs(outputs: list[tuple[str, str]]) -> None:
+    while outputs:
+        deferred = {}
+        for name, mount in outputs:
+            path = Path(name)
+            check_mount(path, Path(mount))
+            try:
+                path.mkdir(parents=True, exist_ok=True)
+            except OSError as exc:
+                if exc.errno not in (errno.EEXIST, errno.EROFS, errno.EACCES, errno.EPERM):
+                    raise
+                # A later writable output can supply this read-only view or link.
+                deferred[name, mount] = exc
+        if len(deferred) == len(outputs):
+            raise next(iter(deferred.values()))
+        outputs = list(deferred)
+
+
+def main(args: list[str]) -> None:
+    if args[0] == "prepare":
+        prepare_outputs(json.loads(args[1]))
+        return
+    direction, kind, name, mount, exchange = args
+    remote, local = Path(name), Path(exchange)
+    check_mount(remote, Path(mount))
+    source, target = (local, remote) if direction == "upload" else (remote, local)
+    copy_path(source, target, directory=kind == "directory")
+
+
+if __name__ == "__main__":
+    try:
+        main(sys.argv[1:])
+    except ValueError as error:
+        print(json.dumps(["boundary", None, str(error), None]))
+        sys.exit(ERROR_EXIT)
+    except OSError as error:
+        print(json.dumps(["io", error.errno, error.strerror or str(error), error.filename]))
+        sys.exit(ERROR_EXIT)
