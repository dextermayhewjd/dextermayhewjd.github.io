+async def test_directory_transfer_uses_contents_of_nested_mount(monkeypatch, tmp_path, existing_mount_point):
+    logs, view = tmp_path / "logs", tmp_path / "view"
+    (logs / "agent").mkdir(parents=True)
+    if existing_mount_point:
