+    )
+    try:
+        await env.start(False)
+        collected = tmp_path / "collected"
+        await env.download_dir("/logs/agent", collected)
+        assert (collected / "view/data").read_bytes() == b"visible"
+        (collected / "view/data").write_bytes(b"updated")
+        await env.upload_dir(collected, "/logs/agent")
+        assert (view / "data").read_bytes() == b"updated"
+        if existing_mount_point:
+            assert (logs / "agent/view/data").read_bytes() == b"hidden"
+        else:
+            assert not (logs / "agent/view/data").exists()
+    finally:
+        await env.stop(True)
