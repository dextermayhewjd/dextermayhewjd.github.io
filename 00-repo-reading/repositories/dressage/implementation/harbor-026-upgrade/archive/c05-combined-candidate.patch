+        assert (tmp_path / "received").read_bytes() == b"visible in the sandbox"
+        with pytest.raises(PermissionError):
+            await env.upload_file(tmp_path / "received", "/logs/agent/probe")
+        (logs / "outside").symlink_to(tmp_path)
+        with pytest.raises(ValueError, match="escapes its mount"):
+            await env.download_file("/logs/outside/received", tmp_path / "copy")
